</v:shape><![endif]--><![if !vml]><img border=3D0 width=3D570 height=3D314
src=3D"VaesenPH_files/image060.gif" v:shapes=3D"image14.png"><![endif]></sp=
an></p>

<p class=3DMsoNormal><span lang=3DEN style=3D'mso-no-proof:yes'><!--[if gte=
 vml 1]><v:shape
 id=3D"image19.png" o:spid=3D"_x0000_i1029" type=3D"#_x0000_t75" style=3D'w=
idth:468pt;
